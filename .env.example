# Copy these into Render's environment settings, or set them in your terminal for local runs.
# Local runs need no DATABASE_URL: the SQLite file is created in ./instance automatically.
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string
COOKIE_SECURE=false            # true on Render (HTTPS)
SITE_URL=http://localhost:5000
